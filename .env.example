ARCORE_BASE_URL=https://clientes.arcore.com:37001
ARCORE_USER=
ARCORE_PASSWORD=
TEST_CODIGO=82502
TEST_MARCA_ID=S8
TEST_SUPERMEDIDA=
ARCORE_STOCK_DIAGNOSTIC=false

# Tiendanube
TIENDANUBE_ACCESS_TOKEN=
TIENDANUBE_STORE_ID=
TIENDANUBE_USER_AGENT=Arcore POC (tu-email@example.com)
TIENDANUBE_TEST_PRICE=1000

# Storage
DATA_DIR=./output

# Dashboard
PORT=3000
DASHBOARD_PORT=3000
DASHBOARD_AUTH_ENABLED=false
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Scheduler
PRODUCTION_SYNC_SCHEDULE_ENABLED=false
PRODUCTION_SYNC_INTERVAL_MINUTES=60
PRODUCTION_SYNC_MODE=PLAN
PRODUCTION_SYNC_STALE_LOCK_MINUTES=120
PRODUCTION_SHUTDOWN_TIMEOUT_MS=30000

# Execution safety
PRODUCTION_SYNC_EXECUTION_CONFIRMED=false
TIENDANUBE_DRY_RUN=true
TIENDANUBE_EXECUTION_ENABLED=false
TIENDANUBE_PRICE_EXECUTION_ENABLED=false
TIENDANUBE_STATUS_EXECUTION_ENABLED=false
TIENDANUBE_IMAGE_EXECUTION_ENABLED=false
TIENDANUBE_CREATE_EXECUTION_ENABLED=false

# Production batch sizing
PRODUCTION_SYNC_BATCH_SIZE_SINGLE=15
PRODUCTION_SYNC_BATCH_SIZE_CREATE=10
PRODUCTION_SYNC_BATCH_SIZE_IMAGE=8
